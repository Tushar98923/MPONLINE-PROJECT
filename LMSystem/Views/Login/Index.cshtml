@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Login - LMSystem</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/css/site.css" rel="stylesheet">
</head>
<body>
<div class="auth-wrapper">
  <i class="bi bi-book-half auth-decor auth-decor-1" aria-hidden="true"></i>
  <i class="bi bi-journal-bookmark auth-decor auth-decor-2" aria-hidden="true"></i>
  <i class="bi bi-mortarboard auth-decor auth-decor-3" aria-hidden="true"></i>
  <i class="bi bi-newspaper auth-decor auth-decor-4" aria-hidden="true"></i>
  <div class="card auth-card p-4">
    <div class="auth-logo"><i class="bi bi-book-half"></i></div>
    <h3 class="mb-1 text-center fw-bold">LMSystem</h3>
    <p class="text-center text-muted mb-4">Library Management System</p>
    @if (ViewBag.LoginError != null)
    {
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @ViewBag.LoginError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    }
    <form asp-controller="Login" asp-action="Verify" method="post" class="needs-validation" novalidate>
      @Html.AntiForgeryToken()
      <div class="mb-3">
        <label asp-for="Username" class="form-label"><i class="bi bi-person me-1"></i>Username</label>
        <input asp-for="Username" class="form-control" required>
        <span asp-validation-for="Username" class="invalid-feedback"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Password" class="form-label"><i class="bi bi-lock me-1"></i>Password</label>
        <input asp-for="Password" type="password" class="form-control" required>
        <span asp-validation-for="Password" class="invalid-feedback"></span>
      </div>
      <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-1"></i>Login</button>
    </form>
    <div class="auth-hint mt-3">
      <i class="bi bi-info-circle text-primary"></i>
      <span class="text-muted small mb-0">Try <strong>admin</strong> / <strong>12345</strong></span>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
