@model BookListViewModel
@{
    ViewData["Title"] = "Books List";
    ViewData["ActiveNav"] = "books";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="fw-bold m-0"><i class="bi bi-book me-2"></i>Books</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add New Book</a>
</div>

<form asp-action="Index" method="get" class="d-flex search-bar gap-2 mb-3 flex-wrap">
    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by title, author or ISBN...">
    <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
    {
        <a asp-action="Index" class="btn btn-link"><i class="bi bi-x-circle me-1"></i>Clear</a>
    }
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>ISBN</th>
                    <th>Published Date</th>
                    <th>Available</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Books.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="bi bi-journal-x"></i>
                                <h6>No books found</h6>
                                <p>@(string.IsNullOrWhiteSpace(Model.SearchQuery) ? "Add your first book to get started." : "Try a different search term or clear the filter.")</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td>@book.Title</td>
                            <td>@book.Author</td>
                            <td>@book.ISBN</td>
                            <td>@book.PublishedDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (book.IsAvailable)
                                {
                                    <span class="badge text-bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Borrowed</span>
                                }
                            </td>
                            <td class="table-actions">
                                <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-info" title="Details"><i class="bi bi-eye"></i></a>
                                @if (book.IsAvailable)
                                {
                                    <a asp-controller="Borrow" asp-action="Create" asp-route-bookId="@book.BookId" class="btn btn-sm btn-success" title="Borrow"><i class="bi bi-journal-check"></i></a>
                                }
                                else
                                {
                                    var activeRecord = book.BorrowRecords?.FirstOrDefault(br => br.ReturnDate == null);
                                    if (activeRecord != null)
                                    {
                                        <a asp-controller="Borrow" asp-action="Return" asp-route-borrowRecordId="@activeRecord.BorrowRecordId" class="btn btn-sm btn-secondary" title="Return"><i class="bi bi-arrow-return-left"></i></a>
                                    }
                                }
                                <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3">
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchQuery="@Model.SearchQuery">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchQuery="@Model.SearchQuery">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchQuery="@Model.SearchQuery">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
