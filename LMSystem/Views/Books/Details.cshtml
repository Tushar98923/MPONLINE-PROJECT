@model Book
@{
    ViewData["Title"] = "Book Details";
    ViewData["ActiveNav"] = "books";
}

<h2 class="fw-bold mb-4"><i class="bi bi-book me-2"></i>Book Details</h2>

<div class="card p-4" style="max-width: 560px;">
    <div class="form-card-header">
        <div class="icon-badge badge-lg badge-primary"><i class="bi bi-journal-text"></i></div>
        <div>
            <h5 class="mb-0">@Model.Title</h5>
            <p>@Model.Author</p>
        </div>
    </div>
    <dl class="row mb-0">
        <dt class="col-sm-4 text-secondary">ISBN</dt>
        <dd class="col-sm-8">@Model.ISBN</dd>
        <dt class="col-sm-4 text-secondary">Published Date</dt>
        <dd class="col-sm-8">@Model.PublishedDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-4 text-secondary">Availability</dt>
        <dd class="col-sm-8">
            @if (Model.IsAvailable)
            {
                <span class="badge text-bg-success">Available</span>
            }
            else
            {
                <span class="badge text-bg-secondary">Borrowed</span>
            }
        </dd>
    </dl>
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Books</a>
    </div>
</div>
