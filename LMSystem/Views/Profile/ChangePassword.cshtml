@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActiveNav"] = "profile";
}

<h2 class="fw-bold mb-4">Change Password</h2>
<div class="card p-4" style="max-width: 560px;">
    <div class="form-card-header">
        <div class="icon-badge badge-lg badge-warning"><i class="bi bi-key"></i></div>
        <div><h5 class="mb-0">Update your password</h5></div>
    </div>
    <form asp-action="ChangePassword" method="post" class="needs-validation" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label"><i class="bi bi-lock me-1"></i>Current Password</label>
            <input asp-for="CurrentPassword" type="password" class="form-control" required>
            <span asp-validation-for="CurrentPassword" class="invalid-feedback"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"><i class="bi bi-lock-fill me-1"></i>New Password</label>
            <input asp-for="NewPassword" type="password" class="form-control" required>
            <span asp-validation-for="NewPassword" class="invalid-feedback"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmNewPassword" class="form-label"><i class="bi bi-lock-fill me-1"></i>Confirm New Password</label>
            <input asp-for="ConfirmNewPassword" type="password" class="form-control" required>
            <span asp-validation-for="ConfirmNewPassword" class="invalid-feedback"></span>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
    </form>
</div>
