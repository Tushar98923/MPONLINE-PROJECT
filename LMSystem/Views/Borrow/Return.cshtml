@model ReturnViewModel
@{
    ViewData["Title"] = "Return Book";
    ViewData["ActiveNav"] = "books";
}

<h2 class="fw-bold mb-4">Return Book</h2>
<div class="card p-4" style="max-width: 560px;">
    <div class="form-card-header">
        <div class="icon-badge badge-lg badge-primary"><i class="bi bi-arrow-return-left"></i></div>
        <div>
            <h5>Return this book</h5>
            <p>Confirm the details below to check it back in.</p>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label"><i class="bi bi-book me-1"></i>Book Title</label>
        <input type="text" class="form-control" value="@Model.BookTitle" readonly>
    </div>
    <div class="mb-3">
        <label class="form-label"><i class="bi bi-person me-1"></i>Borrower Name</label>
        <input type="text" class="form-control" value="@Model.BorrowerName" readonly>
    </div>
    <div class="mb-3">
        <label class="form-label"><i class="bi bi-calendar-event me-1"></i>Borrow Date</label>
        <input type="text" class="form-control" value="@Model.BorrowDate?.ToLocalTime().ToString("g")" readonly>
    </div>
    <form asp-action="Return" method="post">
        <input type="hidden" asp-for="BorrowRecordId">
        <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Confirm Return</button>
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
    </form>
</div>
