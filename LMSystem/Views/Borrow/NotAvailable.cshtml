@{
    ViewData["Title"] = "Not Available";
    ViewData["ActiveNav"] = "books";
}

<div class="card p-4" style="max-width: 560px;">
    <div class="empty-state">
        <i class="bi bi-lock"></i>
        <h6>Not available</h6>
        <p>This book is currently checked out.</p>
    </div>
    <div class="text-center mt-3">
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Books</a>
    </div>
</div>
