@model AccountEditViewModel
@{
    ViewData["Title"] = "Edit Account";
    ViewData["ActiveNav"] = "accounts";
}

<h2 class="fw-bold mb-4">Edit Account</h2>
<div class="card p-4" style="max-width: 560px;">
    <div class="form-card-header">
        <div class="icon-badge badge-lg badge-warning"><i class="bi bi-pencil-square"></i></div>
        <div><h5 class="mb-0">Update account</h5></div>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="needs-validation" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id">
        <div class="mb-3">
            <label class="form-label"><i class="bi bi-person me-1"></i>Username</label>
            <input value="@Model.Username" class="form-control" disabled readonly>
        </div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"><i class="bi bi-badge-tm me-1"></i>Full Name</label>
            <input asp-for="FullName" class="form-control" required>
            <span asp-validation-for="FullName" class="invalid-feedback"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"><i class="bi bi-envelope me-1"></i>Email</label>
            <input asp-for="Email" type="email" class="form-control" required>
            <span asp-validation-for="Email" class="invalid-feedback"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Role" class="form-label"><i class="bi bi-person-badge me-1"></i>Role</label>
            <select asp-for="Role" class="form-select" asp-items="Html.GetEnumSelectList<AccountRole>()"></select>
            <span asp-validation-for="Role" class="invalid-feedback"></span>
        </div>
        <hr>
        <p class="text-muted small">Leave the password fields blank to keep the current password.</p>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"><i class="bi bi-lock me-1"></i>New Password</label>
            <input asp-for="NewPassword" type="password" class="form-control">
            <span asp-validation-for="NewPassword" class="invalid-feedback"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmNewPassword" class="form-label"><i class="bi bi-lock-fill me-1"></i>Confirm New Password</label>
            <input asp-for="ConfirmNewPassword" type="password" class="form-control">
            <span asp-validation-for="ConfirmNewPassword" class="invalid-feedback"></span>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
    </form>
</div>
