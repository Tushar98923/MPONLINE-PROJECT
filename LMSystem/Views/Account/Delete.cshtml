@model Account
@{
    ViewData["Title"] = "Delete Account";
    ViewData["ActiveNav"] = "accounts";
}

<div class="card p-4" style="max-width: 550px;">
    <div class="form-card-header">
        <div class="icon-badge badge-lg badge-danger"><i class="bi bi-trash"></i></div>
        <div>
            <h5>Confirm deletion</h5>
            <p>This action cannot be undone.</p>
        </div>
    </div>
    <dl class="row bg-light p-3 rounded">
        <dt class="col-sm-4 text-secondary">Username</dt>
        <dd class="col-sm-8 fw-bold">@Model.Username</dd>
        <dt class="col-sm-4 text-secondary">Full Name</dt>
        <dd class="col-sm-8">@Model.FullName</dd>
        <dt class="col-sm-4 text-secondary">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>
        <dt class="col-sm-4 text-secondary">Role</dt>
        <dd class="col-sm-8">@Model.Role</dd>
    </dl>
    <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-end mt-3">
        <input type="hidden" asp-for="Id">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Yes, Delete</button>
    </form>
</div>
