@model Publication
@{
    var typeName = Model.Type.ToString();
    ViewData["Title"] = "Modify " + typeName;
    ViewData["ActiveNav"] = Model.Type == PublicationType.Magazine ? "magazines" : "newspapers";
    var icon = Model.Type == PublicationType.Magazine ? "bi-journal-richtext" : "bi-newspaper";
    var badgeClass = Model.Type == PublicationType.Magazine ? "badge-purple" : "badge-info";
}

<h2 class="fw-bold mb-4">Modify @typeName</h2>
<div class="card p-4" style="max-width: 560px;">
    <div class="form-card-header">
        <div class="icon-badge badge-lg @badgeClass"><i class="bi @icon"></i></div>
        <div>
            <h5>Update @(typeName.ToLower()) entry</h5>
            <p>Fields marked required must be filled before saving.</p>
        </div>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="needs-validation" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id">
        <input type="hidden" asp-for="Type">
        <div class="mb-3">
            <label asp-for="Title" class="form-label"><i class="bi bi-type me-1"></i>Title</label>
            <input asp-for="Title" class="form-control" required>
            <span asp-validation-for="Title" class="invalid-feedback"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Publisher" class="form-label"><i class="bi bi-building me-1"></i>Publisher</label>
            <input asp-for="Publisher" class="form-control" required>
            <span asp-validation-for="Publisher" class="invalid-feedback"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PublishedDate" class="form-label"><i class="bi bi-calendar-date me-1"></i>Published Date</label>
            <input asp-for="PublishedDate" type="date" class="form-control" value="@Model.PublishedDate.ToString("yyyy-MM-dd")" required>
            <span asp-validation-for="PublishedDate" class="invalid-feedback"></span>
        </div>
        <div class="mb-4 form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="IsAvailable">
            <label class="form-check-label fw-semibold" asp-for="IsAvailable">Mark item as active / available for borrowing</label>
        </div>
        <button type="submit" class="btn btn-warning text-white"><i class="bi bi-check-lg me-1"></i>Update Changes</button>
        <a asp-action="Index" asp-route-type="@typeName" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
    </form>
</div>
