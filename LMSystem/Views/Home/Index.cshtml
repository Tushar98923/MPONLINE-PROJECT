@model List<Book>
@{
    ViewData["Title"] = "Home";
    ViewData["ActiveNav"] = "home";
    var username = Context.Session.GetString("Username");
    var covers = new[] { "cover-1", "cover-2", "cover-3", "cover-4" };
}

<div class="hero-panel mb-5">
    <i class="bi bi-book-half hero-decor" aria-hidden="true"></i>
    <h1 class="fw-bold mb-2"><i class="bi bi-stars me-2"></i>Welcome back@(username != null ? $", {username}" : "")</h1>
    <p class="mb-0">Browse featured titles, catch the latest announcements, or jump straight into managing books, students, librarians and publications.</p>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold m-0"><i class="bi bi-award me-2"></i>Featured Books</h2>
    <a href="/Books/Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-grid me-1"></i>View All Books</a>
</div>

@if (Model.Count == 0)
{
    <div class="card p-4 mb-5">
        <div class="empty-state">
            <i class="bi bi-journal-x"></i>
            <h6>No books in the catalog yet</h6>
            <p>Add your first book to see it featured here.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        @for (int i = 0; i < Model.Count; i++)
        {
            var book = Model[i];
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="book-cover @covers[i % covers.Length]"><i class="bi bi-book"></i></div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@book.Title</h5>
                        <p class="card-text text-muted small flex-grow-1">By @book.Author &middot; @book.PublishedDate.ToString("yyyy-MM-dd")</p>
                        <a href="/Books/Details/@book.BookId" class="btn btn-primary btn-sm align-self-start">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h2 class="fw-bold mb-3"><i class="bi bi-megaphone me-2"></i>Library Announcements</h2>
<div class="alert alert-info d-flex align-items-start gap-2" role="alert">
    <i class="bi bi-stars fs-5"></i>
    <div><strong>New Arrivals:</strong> Check out the latest books added to our collection, including fresh titles in the Books module.</div>
</div>
<div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
    <i class="bi bi-clock-history fs-5"></i>
    <div><strong>Library Hours Update:</strong> The library will be closed on public holidays. Please plan your visits accordingly.</div>
</div>
<div class="alert alert-success d-flex align-items-start gap-2 mb-0" role="alert">
    <i class="bi bi-newspaper fs-5"></i>
    <div><strong>Publications Desk:</strong> Daily newspapers and the latest magazine issues are now searchable from the sidebar.</div>
</div>
